    "/agents/{agentId}/twitter/check-cookies": {
      "post": {
        "summary": "Check Twitter cookies",
        "description": "Checks if Twitter cookies are valid or not.",
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "auth_token": {
                    "type": "string",
                    "example": "your_auth_token"
                  },
                  "ct0": {
                    "type": "string",
                    "example": "your_ct0_value"
                  },
                  "guest_id": {
                    "type": "string",
                    "example": "your_guest_id"
                  }
                },
                "required": ["auth_token", "ct0", "guest_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resultLogin": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Agent not found"
          },
          "500": {
            "description": "Failed to check cookies"
          }
        }
      }
    }
